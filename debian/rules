#!/usr/bin/make -f
# debian/rules — debhelper build rules for tt-local-generator
#
# This is a Python/shell project with no compiled components.
# debhelper-compat 13 is set in debian/control via Build-Depends.

# Fail loudly on any error inside recipe lines.
export DH_VERBOSE = 1

# Disable all automatic debhelper helpers that try to compile Python bytecode
# or strip binaries — this is an interpreted project.
export DEB_BUILD_OPTIONS = nocheck nostrip

# ── Primary target ────────────────────────────────────────────────────────────
%:
	dh $@

# ── Install ───────────────────────────────────────────────────────────────────
override_dh_install:
	# Create the installation tree under debian/tt-local-generator/
	install -d debian/tt-local-generator/usr/lib/tt-local-generator
	install -d debian/tt-local-generator/usr/bin
	install -d debian/tt-local-generator/usr/share/applications
	install -d debian/tt-local-generator/usr/share/icons/hicolor/32x32/apps
	install -d debian/tt-local-generator/usr/share/doc/tt-local-generator

	# Copy the application source tree (app/, bin/, patches/, plugins/)
	# plugins/ must be installed alongside app/ so plugin_loader can find
	# the built-in generators at /usr/lib/tt-local-generator/plugins/.
	cp -r app bin patches plugins \
	    debian/tt-local-generator/usr/lib/tt-local-generator/
	# Strip test/build artifacts cp -r drags in from a dev checkout (pytest
	# cache, bytecode) — they bloat the package and trip lintian.
	find debian/tt-local-generator/usr/lib/tt-local-generator/app \
	    \( -type d \( -name __pycache__ -o -name .pytest_cache \) -prune -exec rm -rf {} + \)
	find debian/tt-local-generator/usr/lib/tt-local-generator/app -name '*.pyc' -delete

	# The bundled demo/seed media is arch-independent read-only DATA → its FHS
	# home is /usr/share, NOT /usr/lib. demo_seed.resolve_collection_dir finds
	# it via $XDG_DATA_DIRS (/usr/local/share:/usr/share), so an admin can also
	# drop overrides in /usr/local/share/tt-local-generator/ without the package
	# touching /usr/local.
	install -d debian/tt-local-generator/usr/share/tt-local-generator
	cp -r demo-collection \
	    debian/tt-local-generator/usr/share/tt-local-generator/

	# Copy the vendored tt-inference-server snapshot (if already materialised;
	# otherwise snapshot_vendor.sh must be run before dpkg-buildpackage).
	if [ -d vendor/tt-inference-server ]; then \
	    cp -r vendor \
	        debian/tt-local-generator/usr/lib/tt-local-generator/; \
	    : "Strip runtime/build junk that can leak into vendor/ when the media" ; \
	    : "server has been run on the build box — uv-created .workflow_venvs" ; \
	    : "(compiled .so, bundled uv/libc, ~133MB) plus caches and patch .baks." ; \
	    : "These are recreated at runtime; shipping them bloats the .deb and" ; \
	    : "trips lintian (embedded-library/unstripped/missing-libc). Excluding" ; \
	    : "here keeps the package clean regardless of the build box's state." ; \
	    rm -rf debian/tt-local-generator/usr/lib/tt-local-generator/vendor/tt-inference-server/.workflow_venvs; \
	    find debian/tt-local-generator/usr/lib/tt-local-generator/vendor \
	        \( -type d \( -name __pycache__ -o -name .git \) -prune -exec rm -rf {} + \) ; \
	    find debian/tt-local-generator/usr/lib/tt-local-generator/vendor \
	        \( -name '*.pyc' -o -name '*.bak' -o -name '.gitignore' -o -name '.gitmodules' \) -delete; \
	else \
	    echo "WARNING: vendor/tt-inference-server not found." \
	         "Run bin/snapshot_vendor.sh first." >&2; \
	fi
	# snapshot_vendor.sh saves the env template as .env.default; promote it to
	# .env so the conffiles entry is satisfied (dpkg rejects packages that list
	# conffiles they don't actually install).
	if [ ! -f debian/tt-local-generator/usr/lib/tt-local-generator/vendor/tt-inference-server/.env ]; then \
	    if [ -f debian/tt-local-generator/usr/lib/tt-local-generator/vendor/tt-inference-server/.env.default ]; then \
	        cp debian/tt-local-generator/usr/lib/tt-local-generator/vendor/tt-inference-server/.env.default \
	           debian/tt-local-generator/usr/lib/tt-local-generator/vendor/tt-inference-server/.env; \
	    else \
	        printf '# tt-inference-server environment\n# Edit before running.\n' > \
	           debian/tt-local-generator/usr/lib/tt-local-generator/vendor/tt-inference-server/.env; \
	    fi; \
	fi

	# Verify-before-ship: the staged vendor tree must pass patch verification
	# (fail loud instead of silently shipping an unpatched/drifted vendor).
	# CI (release-deb.yml) applies patches before this point, so a local
	# `dpkg-buildpackage` — which skips that CI-only step — must not silently
	# ship an unpatched vendor either.
	/usr/bin/python3 app/patch_verify.py \
	    --vendor debian/tt-local-generator/usr/lib/tt-local-generator/vendor/tt-inference-server
	# Stricter check: patch_verify only confirms the injector ANCHOR still
	# exists in run_docker_server.py — that's true even in an UNPATCHED tree,
	# since applying the patch inserts a block *before* the anchor and leaves
	# the anchor line itself untouched. It does not prove the inject actually
	# landed. Since the staged tree is now expected to be patched (CI applies
	# patches before packaging; see above), assert a concrete marker from the
	# Step-2 inject block is present, so a reordered/skipped apply step fails
	# the build loudly instead of shipping an unpatched vendor.
	if ! grep -q tt_dit_patches_dir \
	    debian/tt-local-generator/usr/lib/tt-local-generator/vendor/tt-inference-server/workflows/run_docker_server.py; then \
	    echo "ERROR: staged vendor is unpatched (tt_dit_patches_dir inject" >&2; \
	    echo "  missing from run_docker_server.py). Run" >&2; \
	    echo "  'bin/apply_patches.sh vendor/tt-inference-server' before" >&2; \
	    echo "  dpkg-buildpackage, or verify CI's apply+verify step ran" >&2; \
	    echo "  before this build." >&2; \
	    exit 1; \
	fi

	# Copy the top-level launchers and version file.
	install -m 755 tt-gen tt-ctl \
	    debian/tt-local-generator/usr/lib/tt-local-generator/
	install -m 644 VERSION \
	    debian/tt-local-generator/usr/lib/tt-local-generator/

	# ── /usr/bin/ entries ──────────────────────────────────────────────────
	# Primary globally-namespaced names.
	ln -s /usr/lib/tt-local-generator/tt-gen \
	    debian/tt-local-generator/usr/bin/tt-local-gen
	ln -s /usr/lib/tt-local-generator/tt-ctl \
	    debian/tt-local-generator/usr/bin/tt-local-gen-ctl
	# Model download helper — used by tt-model-* postinst scripts and
	# exposed for manual re-runs (e.g. after a failed install).
	ln -s /usr/lib/tt-local-generator/bin/download_model.sh \
	    debian/tt-local-generator/usr/bin/tt-local-gen-download-model
	# Deprecated aliases — kept for one release cycle then removed.
	ln -s tt-local-gen \
	    debian/tt-local-generator/usr/bin/tt-gen
	ln -s tt-local-gen-ctl \
	    debian/tt-local-generator/usr/bin/tt-ctl

	# ── XDG assets ────────────────────────────────────────────────────────
	install -m 644 \
	    app/assets/ai.tenstorrent.tt-video-gen.desktop \
	    debian/tt-local-generator/usr/share/applications/

	install -m 644 \
	    app/assets/tenstorrent.png \
	    debian/tt-local-generator/usr/share/icons/hicolor/32x32/apps/ai.tenstorrent.tt-video-gen.png

	# ── profile.d — system-wide HF_HOME / HF_HUB_CACHE ──────────────────
	install -d debian/tt-local-generator/etc/profile.d
	install -m 644 debian/tt-local-generator.sh \
	    debian/tt-local-generator/etc/profile.d/tt-local-generator.sh

	# ── Docs ──────────────────────────────────────────────────────────────
	install -m 644 README.md GUIDE.md \
	    debian/tt-local-generator/usr/share/doc/tt-local-generator/

# ── Fix permissions for shell scripts ─────────────────────────────────────────
override_dh_fixperms:
	dh_fixperms
	# Ensure all bin/ scripts are executable after dh_fixperms normalises them.
	find debian/tt-local-generator/usr/lib/tt-local-generator/bin \
	     -name '*.sh' -exec chmod +x {} +
	chmod +x \
	    debian/tt-local-generator/usr/lib/tt-local-generator/tt-gen \
	    debian/tt-local-generator/usr/lib/tt-local-generator/tt-ctl

# ── Skip auto-generated Python bytecode ───────────────────────────────────────
# dh_python3 would try to byte-compile; skip it — we use /usr/bin/python3
# directly and .pyc files would reference the wrong install path.
override_dh_python3:
	# intentionally empty

# ── Skip auto compression of large files ─────────────────────────────────────
# The docker/ LFS archive is intentionally NOT included in the deb (pulled at
# postinst time). Nothing here needs special compression handling.
override_dh_compress:
	dh_compress -X.sh -X.py -Xtt-gen -Xtt-ctl
