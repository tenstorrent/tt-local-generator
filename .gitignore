__pycache__/
*.py[cod]
*.swp
.DS_Store
.env
.venv/
.superpowers/
.worktrees/
prompts/markov_output.txt
batch_generate.log

# Vendored tt-inference-server shallow clone.
# The pinned commit SHA is tracked in vendor/VENDOR_SHA.
# The checkout itself is not committed (large; regenerated by bin/setup_vendor.sh).
vendor/tt-inference-server/

# Docker image archive (~7.9 GB) — too large for GitHub LFS (2 GB limit).
# Distribute separately (SCP, rsync, direct download).
docker/*.tar.gz
docker/*.tar

# dpkg-buildpackage build artifacts (generated by debhelper during build).
# These are build-time outputs, not source — never commit them.
debian/.debhelper/
debian/debhelper-build-stamp
debian/files
debian/*.debhelper.log
debian/*.substvars
debian/*.postrm.debhelper
debian/*.debhelper
debian/tt-local-generator/
debian/tt-local-generator-models-all/
# All tt-model-* package staging dirs — one glob covers current + future
# models (flux-dev, wan2-i2v, z-image, motif, animatediff, …). The trailing
# slash matches only the build DIRECTORIES, never the tracked source
# debian/tt-model-*.{postinst,config,templates} maintainer scripts.
debian/tt-model-*/

# Local scratch files
*.ans
*.raw.txt
landscape_glitch.svg
steinbeck.png
generate_library.sh
/logs/
media_*.log

# tt-animatediff submodule — weights and generated output are not committed
vendor/tt-animatediff/weights/
vendor/tt-animatediff/output/
vendor/tt-animatediff/.claude/

# Local-only working dirs (build caches, scratch generation output, doc builds).
# experiments/rust-ui/target alone is ~1.8 GB of Rust build artifacts — never commit.
experiments/
generated/
docs/docs/
# Scratch README preview rendered locally (pandoc) to eyeball the docs in a browser.
/README-preview.html

# Compiled bytecode inside patches/ (never track)
patches/**/__pycache__/
patches/**/*.pyc

# The shipped demo collection is intentionally tracked in full, even where a
# global pattern above (e.g. *.ans) would otherwise exclude its media.
!demo-collection/**
